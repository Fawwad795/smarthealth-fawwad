# App — environment template
#
# Copy to `.env` in your repo root and fill in real values.
# `.env` MUST be in .gitignore. A committed API key is an automatic fail.
#
# Hostnames below assume you run your app INSIDE docker compose.
# If you run the app on your laptop against dockerised infra, swap
# `postgres`/`redis` for `localhost` and use `localhost:29092` for Kafka.

# --- App ---------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Database ----------------------------------------------------------
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/app

# --- Redis: cache, idempotency keys, rate limiting, Celery broker -------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Auth --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-locally-and-never-commit-a-real-one
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Temporal (Week 2+) ------------------------------------------------
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=app-workflow

# --- Kafka (Week 3+) ---------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=app-analytics
KAFKA_TOPIC_PREFIX=app

# --- Domain rules ------------------------------------------------------
# Add project-specific constants here (capacity limits, TTLs, etc.)
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# --- AI layer (Week 4+) ------------------------------------------------
# You provision your own free keys — do not commit them here, fill in .env.
#
# LLM — recommended free option: Groq (https://console.groq.com/keys)
#   Other options: OpenAI, Anthropic (paid), HF Inference (free tier)
LLM_PROVIDER=groq                      # groq | openai | anthropic
LLM_API_KEY=                           # paste in .env only, never here
LLM_MODEL=llama-3.1-8b-instant         # fast and free on Groq; swap if you use a different provider

# Embeddings — recommended free option: HF Inference API
#   Sign up at https://huggingface.co/settings/tokens, use a free-tier token.
#   Provider docs: https://huggingface.co/docs/inference-providers/providers/hf-inference
EMBEDDING_PROVIDER=huggingface         # huggingface | openai
EMBEDDING_API_KEY=                     # your HF token — paste in .env only
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Retrieval tuning — set these deliberately and justify them in your docs.
CHUNK_TARGET_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
EMBEDDING_BATCH_SIZE=64
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.65          # calibrated for all-MiniLM-L6-v2 (384-dim)

# Guardrails
AI_MAX_QUESTION_CHARS=1000
AI_REQUEST_TIMEOUT_SECONDS=60
AI_RATE_LIMIT_PER_MINUTE=10
AI_ANSWER_CACHE_TTL_SECONDS=3600

# Set to true in tests so no real API calls are made.
USE_FAKE_LLM=false
