# App — environment template
#
# Copy to `.env` in your repo root and fill in real values.
# `.env` MUST be in .gitignore. A committed API key is an automatic fail.
#
# Hostnames below assume you run your app INSIDE docker compose.
# If you run the app on your laptop against dockerised infra, swap
# `postgres`/`redis` for `localhost` and use `localhost:29092` for Kafka.

# --- App ---------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Database ----------------------------------------------------------
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/app
# Dropped and recreated by the test suite. Must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/app_test

# --- Redis: cache, idempotency keys, rate limiting, Celery broker -------
REDIS_URL=redis://redis:6379/0
TEST_REDIS_URL=redis://redis:6379/15
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Seconds any single Redis command may take before it is treated as failed.
REDIS_TIMEOUT_SECONDS=2.0

# --- Auth --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-locally-and-never-commit-a-real-one
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Temporal (Week 2+) ------------------------------------------------
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=app-workflow

# --- Kafka (Week 3+) ---------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=app-analytics
KAFKA_TOPIC_PREFIX=app

# --- Domain rules ------------------------------------------------------
# Add project-specific constants here (capacity limits, TTLs, etc.)
IDEMPOTENCY_KEY_TTL_SECONDS=86400
BILLING_FORCE_FAIL=false

# --- AI layer (Week 4+) ------------------------------------------------
# You provision your own free keys — do not commit them here, fill in .env.
#
# LLM: groq (free key: https://console.groq.com/keys), openai (same request
#   format, OpenAI key) or fake (no calls; the tests use it).
LLM_PROVIDER=groq
# Key in .env only, alone on its line: Compose reads a comment after an empty
#   value as the key.
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b             # with openai, an OpenAI model name

# Embeddings. "local" runs the model inside the containers: the image
#   downloads it at build time, so it needs no key and no network.
#   "huggingface" uses the hosted HF Inference API instead and needs a token
#   with inference credits (https://huggingface.co/settings/tokens).
#   "fake" is the tests' stand-in and ranks by shared words only.
EMBEDDING_PROVIDER=local               # local | huggingface | fake
# huggingface only. Your HF token goes in .env only, with nothing after it on the line.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # changing it needs an image rebuild and a migration
EMBEDDING_DIMENSIONS=384
EMBEDDING_TIMEOUT_SECONDS=20           # huggingface only: above an ~8s cold start, below the 30s Activity timeout

# Retrieval tuning — set these deliberately and justify them in your docs.
# No chunk size or overlap: each service is one chunk (app/ai/chunking.py).
EMBEDDING_BATCH_SIZE=64
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.31          # chosen by `make eval` (task 4.10); run it again after changing the model

# Guardrails
AI_MAX_QUESTION_CHARS=1000
AI_REQUEST_TIMEOUT_SECONDS=60          # per step (connecting, each wait for more reply), not per call
AI_RATE_LIMIT_PER_MINUTE=10
AI_ANSWER_CACHE_TTL_SECONDS=3600
