# Keep the build context small and never bake secrets into the image.
.git
.env
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
.mypy_cache/
CLAUDE.md
.claude/
# Local scratch work (the explainer-video toolkit, about 1GB). Without this
# line every build sent it to Docker before a single layer ran.
.tmp/
